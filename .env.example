PORT=3001
HOST=127.0.0.1
DATA_DIR=./data
DEV_DATA_DIR=./data/dev
DEV_RECIPE_PASSWORD=local-preview-only
# Set these only for Turso. Leave blank to use the local SQLite database.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Set a long private password before adding recipes. Never prefix it with VITE_.
RECIPE_PASSWORD=
# Server-only OpenAI credentials for the recipe generator. Never prefix with VITE_.
OPENAI_API_KEY=
OPENAI_RECIPE_MODEL=gpt-5.6-luna
# Local Sign in with ChatGPT (uses an eligible ChatGPT plan instead of API credits).
SIWC_LOCAL_ENABLED=true
LOCAL_APP_URL=http://127.0.0.1:5173/
CHATGPT_DATA_DIR=./data/dev
CHATGPT_RECIPE_MODEL=
