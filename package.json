    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "vite": "^6.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3"
  },
  "optionalDependencies": {
    "@tailwindcss/oxide-win32-x64-msvc": "4.3.3"
  }
