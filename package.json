{
  "name": "meal-picker-for-you",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "concurrently -k \"node --watch server/dev.js\" \"vite --host 127.0.0.1\"",
